<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.VBox?>

<fx:root prefHeight="400.0" prefWidth="800.0" type="VBox" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="File">
          <items>
              <MenuItem mnemonicParsing="false" onAction="#onLoadConfig" text="Load Config" />
              <MenuItem mnemonicParsing="false" onAction="#onSaveConfig" text="Save Config" />
              <MenuItem mnemonicParsing="false" onAction="#onAddDevice" text="Add Switch" />
              <MenuItem mnemonicParsing="false" onAction="#onDumpEndpoints" text="Dump Endpoints to CSV" />
            <MenuItem mnemonicParsing="false" onAction="#onQuit" text="Quit" />
          </items>
        </Menu>
        <Menu mnemonicParsing="false" text="Edit">
               <items>
                  <CheckMenuItem mnemonicParsing="false" text="Hide Down Interfaces" />
                  <CheckMenuItem mnemonicParsing="false" text="Hide Non Trunk Interfaces" />
               </items></Menu>
        <Menu mnemonicParsing="false" text="Help">
          <items>
            <MenuItem mnemonicParsing="false" text="About Fabric" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
      <SplitPane dividerPositions="0.21679197994987467" prefHeight="160.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <items>
            <VBox maxHeight="1.7976931348623157E308" prefHeight="200.0" prefWidth="100.0">
               <children>
                  <TextField fx:id="txtFilterMac" promptText="Filter Mac" />
                  <TreeView fx:id="tvDevices" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <ListView fx:id="lstMonitor" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200.0" prefWidth="200.0" />
         </items>
      </SplitPane>
      <Button mnemonicParsing="false" onAction="#onScanAllDevices" text="Scan All Devices" />
  </children>
</fx:root>
